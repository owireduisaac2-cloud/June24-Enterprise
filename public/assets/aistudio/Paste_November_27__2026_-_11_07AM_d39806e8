        async function handleProductUpload(e) {
            e.preventDefault();
            const editId = document.getElementById('upload-edit-id').value;
            const name = document.getElementById('upload-name').value;
            const category = document.getElementById('upload-category').value;
            const price = parseFloat(document.getElementById('upload-price').value);
            const tag = document.getElementById('upload-tag').value;
            const icon = document.getElementById('upload-icon').value;
            const description = document.getElementById('upload-description').value;
            
            const imageUrls = currentUploadedImagesBase64.length > 0 ? [...currentUploadedImagesBase64] : ["ASICS Gel-Picteer Trail Sneakers.png"];

            if (editId) {
                const index = products.findIndex(p => String(p.id) === String(editId));
                if (index !== -1) {
                    const updatedProduct = { ...products[index], name, category, price, tag, icon, description, imageUrls };
                    products[index] = updatedProduct;

                    try {
                        if (window.db && window.setDoc && window.doc) {
                            const appId = window.appId || 'june24-enterprise-app';
                            const itemRef = window.doc(window.db, 'artifacts', appId, 'public', 'data', 'catalog', String(editId));
                            await window.setDoc(itemRef, updatedProduct);
                        }
                    } catch (err) {
                        console.warn("Cloud update notice:", err);
                    }

                    showToast("Product Updated", `${name} details saved.`);
                }
            } else {
                const newId = 'prod_' + Date.now();
                const newProduct = { id: newId, name, category, price, tag, icon, description, imageUrls };

                try {
                    if (window.db && window.setDoc && window.doc) {
                        const appId = window.appId || 'june24-enterprise-app';
                        const itemRef = window.doc(window.db, 'artifacts', appId, 'public', 'data', 'catalog', String(newId));
                        await window.setDoc(itemRef, newProduct);
                    }
                } catch (err) {
                    console.warn("Cloud save notice:", err);
                }

                products.unshift(newProduct);
                showToast("Product Published", `${name} added to catalog.`);
            }

            saveCatalogToLocalStorage();
            renderCatalog(products);
            renderAdminInventory();
            resetProductForm();
        }

        async function deleteProduct(id) {
            products = products.filter(p => String(p.id) !== String(id));
