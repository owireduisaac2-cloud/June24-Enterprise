        // Cart & Wishlist Handlers
        function addToCart(productId) {
            const product = products.find(p => String(p.id) === String(productId));
            if (!product) return;
            const existing = cart.find(c => String(c.id) === String(productId));

            if (existing) {
                existing.qty += 1;
            } else {
                cart.push({ ...product, qty: 1 });
            }

            updateCartUI();
            showToast("Added To Cart", `${product.name} added to your bag.`);
        }

        function updateCartQty(productId, delta) {
            const item = cart.find(c => String(c.id) === String(productId));
            if (!item) return;

            item.qty += delta;
            if (item.qty <= 0) {
                cart = cart.filter(c => String(c.id) !== String(productId));
            }
            updateCartUI();
        }

        function updateCartUI() {
            const totalItems = cart.reduce((sum, item) => sum + item.qty, 0);
            const cartCount = document.getElementById('cart-count');
            if (cartCount) cartCount.innerText = totalItems;

            const drawerItems = document.getElementById('drawer-items');
            if (!drawerItems) return;
            drawerItems.innerHTML = '';

            if (cart.length === 0) {
                drawerItems.innerHTML = `
                    <div class="text-center py-12 text-slate-400">
                        <i class="fa-solid fa-bag-shopping text-4xl mb-2 opacity-50"></i>
                        <p class="text-xs font-bold">Your cart is currently empty</p>
                    </div>
                `;
            } else {
                cart.forEach(item => {
                    const row = document.createElement('div');
                    row.className = 'flex items-center justify-between p-3 bg-slate-50 rounded-xl border border-slate-200';
                    row.innerHTML = `
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 bg-slate-200 rounded-lg flex items-center justify-center text-navy-900">
                                <i class="fa-solid ${item.icon || 'fa-box'} text-lg"></i>
                            </div>
                            <div>
                                <h5 class="text-xs font-bold text-navy-900 leading-tight">${item.name}</h5>
                                <p class="text-[11px] font-semibold text-gold-600">GH₵ ${parseFloat(item.price).toFixed(2)}</p>
                            </div>
                        </div>
                        <div class="flex items-center space-x-2">
                            <button onclick="updateCartQty('${item.id}', -1)" class="w-6 h-6 bg-slate-200 hover:bg-slate-300 rounded text-xs font-bold">-</button>
                            <span class="text-xs font-bold px-1">${item.qty}</span>
                            <button onclick="updateCartQty('${item.id}', 1)" class="w-6 h-6 bg-slate-200 hover:bg-slate-300 rounded text-xs font-bold">+</button>
                        </div>
                    `;
                    drawerItems.appendChild(row);
                });
            }

            calculateTotals();
        }

        function calculateTotals() {
            const subtotal = cart.reduce((sum, item) => sum + (parseFloat(item.price) * item.qty), 0);
            const delivery = subtotal > 0 ? 25 : 0;
            const discountAmount = subtotal * appliedDiscount;
            const grandTotal = Math.max(0, subtotal + delivery - discountAmount);

            const elemSub = document.getElementById('cart-subtotal');
            const elemDel = document.getElementById('cart-delivery');
            const elemGrand = document.getElementById('cart-grand-total');
            const elemFinal = document.getElementById('checkout-final-total');

            if (elemSub) elemSub.innerText = `GH₵ ${subtotal.toFixed(2)}`;
            if (elemDel) elemDel.innerText = `GH₵ ${delivery.toFixed(2)}`;
            if (elemGrand) elemGrand.innerText = `GH₵ ${grandTotal.toFixed(2)}`;
            if (elemFinal) elemFinal.innerText = `GH₵ ${grandTotal.toFixed(2)}`;

            const discountRow = document.getElementById('discount-row');
            if (appliedDiscount > 0 && discountRow) {
                discountRow.classList.remove('hidden');
                document.getElementById('cart-discount').innerText = `-GH₵ ${discountAmount.toFixed(2)}`;
            } else if (discountRow) {
                discountRow.classList.add('hidden');
            }
        }

        function applyCoupon() {
            const input = document.getElementById('coupon-code').value.trim().toUpperCase();
            const message = document.getElementById('coupon-message');
            message.classList.remove('hidden', 'text-green-600', 'text-red-500');

            if (input === "JUNE24") {
                appliedDiscount = 0.10;
                message.innerText = "10% Discount applied successfully!";
                message.classList.add('text-green-600');
                calculateTotals();
            } else {
                appliedDiscount = 0;
                message.innerText = "Invalid coupon code. Try 'JUNE24'.";
                message.classList.add('text-red-500');
                calculateTotals();
            }
        }

