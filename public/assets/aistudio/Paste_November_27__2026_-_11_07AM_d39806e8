        // Initial Products Database (Base Fallback including ASICS Sneakers)
        const defaultProducts = [
            { id: 1, name: "ASICS Gel-Picteer Trail Sneakers", category: "footwear", price: 420, icon: "fa-shoe-prints", tag: "Hot Release", imageUrls: ["ASICS Gel-Picteer Trail Sneakers.png"], description: "Rugged trail sneakers featuring gel cushioning and reinforced rubber outsole for superior outdoor grip." },
            { id: 2, name: "High-Cut Tactical Military Boot", category: "cadet", price: 340, icon: "fa-person-military-rifle", tag: "Best Seller", description: "Heavy-duty high-cut tactical boots for security officers and cadets. Features water-resistant leather." },
            { id: 3, name: "Made in Ghana Handmade Leather Loafers", category: "ghana", price: 220, icon: "fa-shoe-prints", tag: "Ghana Crafted", description: "100% genuine Ghanaian handcrafted leather loafers. Comfortable and durable for formal or semi-formal wear." },
            { id: 4, name: "School Cadet Parade Officers Shoe", category: "cadet", price: 280, icon: "fa-user-tie", tag: "Cadet Spec", description: "Polished Oxford-style parade shoes designed for school cadet corps inspections and official events." },
            { id: 5, name: "Ghana National Team Streetwear Jersey", category: "clothing", price: 160, icon: "fa-shirt", tag: "Official Edition", description: "Breathable polyester fan jersey with authentic national emblem embroidery." },
            { id: 6, name: "Heavy Duty Security Belt & Accessories Set", category: "cadet", price: 120, icon: "fa-shield-halved", tag: "Gear", description: "Complete tactical utility belt with heavy-duty brass buckle and pouch attachments." },
            { id: 7, name: "Handcrafted Male Native Leather Slippers", category: "ghana", price: 180, icon: "fa-shoe-prints", tag: "100% Leather", description: "Traditional Ghanaian leather slippers crafted for longevity and traditional occasions." },
            { id: 8, name: "Low-Top Urban Casual Sneakers", category: "footwear", price: 250, icon: "fa-shoe-prints", tag: "New Arrival", description: "Lightweight casual sneakers designed for everyday street wear." },
            { id: 9, name: "Customized Enterprise Crewneck Sweater", category: "clothing", price: 195, icon: "fa-shirt", tag: "Apparel", description: "Soft fleece cotton crewneck sweater featuring June 24 Enterprise insignia." }
        ];

        let products = [...defaultProducts];
        let cart = [];
        let wishlist = [];
        let appliedDiscount = 0;
        let activeSlideIndex = 0;
        let isAdminLoggedIn = false;
        let currentUploadedImagesBase64 = [];
        let editingProductId = null;

        // Default Admin Login Credentials
        let adminCredentials = {
            email: "admin@june24.com",
            password: "password123"
        };

        // Window load initialization
        window.onload = function() {
            try {
                const savedCreds = localStorage.getItem('june24_admin_creds');
                if (savedCreds) {
                    adminCredentials = JSON.parse(savedCreds);
                }
            } catch(e) {}

            loadStoreCatalog();
            startHeroAutoSlide();
        };

        // Load Store Catalog (Local Storage + Firestore sync fallback)
        function loadStoreCatalog() {
            let localItems = null;
            try {
                const storedCatalog = localStorage.getItem('june24_local_catalog');
                if (storedCatalog) {
                    localItems = JSON.parse(storedCatalog);
                }
            } catch (e) {
                console.warn("Local storage read error:", e);
            }

            if (window.db && window.onSnapshot && window.collection) {
                try {
                    const appId = window.appId || 'june24-enterprise-app';
                    const catalogRef = window.collection(window.db, 'artifacts', appId, 'public', 'data', 'catalog');
                    
                    window.onSnapshot(catalogRef, (snapshot) => {
                        if (!snapshot.empty) {
                            const cloudItems = [];
                            snapshot.forEach((docSnap) => {
                                cloudItems.push({ id: docSnap.id, ...docSnap.data() });
                            });
                            
                            // Merge cloud items with local items, avoiding duplication
                            const combined = [...cloudItems];
                            if (localItems) {
                                localItems.forEach(locItem => {
                                    if (!combined.some(c => String(c.id) === String(locItem.id))) {
                                        combined.push(locItem);
                                    }
                                });
                            }
                            products = combined;
                            saveCatalogToLocalStorage();
                        } else {
                            products = localItems && localItems.length > 0 ? localItems : [...defaultProducts];
                        }
                        renderCatalog(products);
                        if (isAdminLoggedIn) renderAdminInventory();
                    }, (err) => {
                        console.warn("Firestore snapshot listener notice:", err);
                        products = localItems && localItems.length > 0 ? localItems : [...defaultProducts];
                        renderCatalog(products);
                    });
                    return;
