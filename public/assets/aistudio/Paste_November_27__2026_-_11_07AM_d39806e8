        // Multi-image reader preview helper with Cover Selector for Admin Panel
        function previewImageFiles(event) {
            const files = event ? event.target.files : null;
            if (files && files.length > 0) {
                currentUploadedImagesBase64 = [];
                let loadedCount = 0;
                Array.from(files).forEach(file => {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        currentUploadedImagesBase64.push(e.target.result);
                        loadedCount++;
                        if (loadedCount === files.length) {
                            renderPreviewThumbnails();
                        }
                    };
                    reader.readAsDataURL(file);
                });
            } else {
                renderPreviewThumbnails();
            }
        }

        function renderPreviewThumbnails() {
            const previewBox = document.getElementById('image-preview-box');
            const previewThumbnails = document.getElementById('preview-thumbnails');
            const previewCount = document.getElementById('preview-count');
            if (!previewBox || !previewThumbnails) return;

            if (currentUploadedImagesBase64.length > 0) {
                previewBox.classList.remove('hidden');
                previewThumbnails.innerHTML = '';
                if (previewCount) previewCount.innerText = currentUploadedImagesBase64.length;

                currentUploadedImagesBase64.forEach((imgUrl, index) => {
                    const isCover = index === 0;
                    const thumb = document.createElement('div');
                    thumb.className = `relative w-14 h-14 rounded-lg border-2 ${isCover ? 'border-gold-500 ring-2 ring-gold-400' : 'border-slate-300'} overflow-hidden shrink-0 group cursor-pointer`;
                    thumb.onclick = () => setCoverImage(index);
                    thumb.innerHTML = `
                        <img src="${imgUrl}" class="w-full h-full object-cover">
                        ${isCover ? '<span class="absolute top-0 left-0 bg-gold-500 text-navy-950 font-black text-[8px] px-1 py-0.2 rounded-br">COVER</span>' : ''}
                        <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-[9px] font-bold text-white text-center p-0.5">
                            Set Cover
                        </div>
                    `;
                    previewThumbnails.appendChild(thumb);
                });
            } else {
                previewBox.classList.add('hidden');
            }
        }

        function setCoverImage(index) {
            if (index > 0 && index < currentUploadedImagesBase64.length) {
                const cover = currentUploadedImagesBase64.splice(index, 1)[0];
                currentUploadedImagesBase64.unshift(cover);
                renderPreviewThumbnails();
                showToast("Cover Updated", "Selected image set as primary catalog cover.");
            }
        }

